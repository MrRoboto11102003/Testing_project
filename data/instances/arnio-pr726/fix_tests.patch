     def test_duplicate_non_string_labels_raises(self):
         df = pd.DataFrame([[1, 2, 3]], columns=[0, 1, 0])
         with pytest.raises(ValueError, match="duplicate column labels") as exc_info:
             ar.from_pandas(df)
