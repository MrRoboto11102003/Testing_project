+
+        r_corner = math.sqrt(50**2 + 50**2) * 0.01
+        expected = (10.0 / math.sqrt(10.0**2 + r_corner**2)) ** 4
+        assert abs(vignetted[0, 0] - expected) < 1e-9
+        assert vignetted[50, 50] == 1.0
+
