+            """
+            from src.gui.storage import LensStorage
+
+            self.temp_db = tempfile.NamedTemporaryFile(suffix=".db", delete=False).name
+            self.window = OpenLensWindow()
+            self.window._storage = LensStorage(self.temp_db)
